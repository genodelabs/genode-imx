<config>

	<parent-provides>
		<service name="CPU"/>
		<service name="IO_MEM"/>
		<service name="IRQ"/>
		<service name="LOG"/>
		<service name="PD"/>
		<service name="RM"/>
		<service name="ROM"/>
		<service name="Timer"/>
		<service name="Uplink"/>
	</parent-provides>

	<default caps="100"/>

	<start name="report_rom" caps="100">
		<resource name="RAM" quantum="1M"/>
		<provides>
			<service name="Report"/>
			<service name="ROM"/>
		</provides>
		<config verbose="no">
			<policy label="eth1 -> mac" report="eeprom -> eeprom_entry_2"/>
			<policy label="eth2 -> mac" report="eeprom -> eeprom_entry_1"/>
		</config>
		<route>
			<any-service> <parent/> </any-service>
		</route>
	</start>

	<start name="platform" caps="150" managing_system="yes">
		<binary name="imx8mp_platform"/>
		<resource name="RAM" quantum="2M"/>
		<provides>
			<service name="Platform"/>
			<service name="Regulator"/>
		</provides>
		<config>
			<policy label="eth1 -> " info="yes"> <device name="fec"/> </policy>
			<policy label="eth2 -> " info="yes"> <device name="eqos"/> </policy>
			<policy label="i2c -> "  info="yes"> <device name="i2c2"/> </policy>
			<policy label="pin -> "  info="yes"> <device name="gpio1"/> </policy>
		</config>
		<route>
			<any-service> <parent/> </any-service>
		</route>
	</start>

	<start name="pin" caps="150">
		<binary name="imx_pio"/>
		<resource name="RAM" quantum="2M"/>
		<provides>
			<service name="Pin_control"/>
			<service name="Pin_state"/>
			<service name="IRQ"/>
		</provides>
		<config>
			<!-- deassert reset signal of STMMAC NICs Phy -->
			<out name="STMMAC_PHY_nRST" bank="0" index="10" default="off"/>
			<policy label="eth2 -> eqos_phy_reset" pin="STMMAC_PHY_nRST"/>
		</config>
		<route>
			<service name="Platform"> <child name="platform"/> </service>
			<any-service> <parent/> </any-service>
		</route>
	</start>

	<start name="i2c" caps="150">
		<binary name="imx8q_evk_i2c"/>
		<resource name="RAM" quantum="2M"/>
		<provides>
			<service name="I2c"/>
		</provides>
		<config verbose="yes">
			 <policy label_prefix="eeprom" bus_address="0x50"/>
		</config>
		<route>
			<service name="Platform"> <child name="platform"/> </service>
			<any-service> <parent/> </any-service>
		</route>
	</start>

	<start name="eeprom">
		<binary name="imx8mp_iot_gate_eeprom_reader"/>
		<resource name="RAM" quantum="10M"/>
		<route>
			<service name="I2c"> <child name="i2c"/> </service>
			<service name="Report"> <child name="report_rom"/> </service>
			<any-service> <parent/> </any-service>
		</route>
	</start>

	<start name="eth1" caps="200" ram="20M">
		<binary name="fec_nic"/>
		<config/>
		<route>
			<service name="ROM" label="nic.dtb"> <parent label="fec_nic-imx8mp_iot_gate.dtb"/> </service>
			<service name="ROM" label="mac"> <child name="report_rom"/> </service>
			<service name="Platform"> <child name="platform"/> </service>
			<any-service> <parent/> </any-service>
		</route>
	</start>

	<start name="eth2" caps="200" ram="20M">
		<binary name="stmmac_nic"/>
		<config mac_address_by_rom="yes" phy_reset_control="yes" phy_reset_active_high="no"/>
		<route>
			<service name="ROM" label="nic.dtb"> <parent label="stmmac_nic-imx8mp_iot_gate.dtb"/> </service>
			<service name="ROM" label="mac"> <child name="report_rom"/> </service>
			<service name="Platform"> <child name="platform"/> </service>
			<service name="Pin_control"> <child name="pin"/> </service>
			<any-service> <parent/> </any-service>
		</route>
	</start>

</config>
